<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?define Capabilities = "Software\HubbyPDF\Capabilities" ?>
  <?define PdfProgId = "HubbyPDF.PDF" ?>
  <Product Id="$(var.ProductCode)" Name="HubbyPDF" Language="1033" Version="$(var.AppVersion)"
           Manufacturer="HubbyPDF" UpgradeCode="12E7160D-6F01-4B2A-A61A-A80D9620B594">
    <Package InstallerVersion="500" Platform="x64" InstallScope="perMachine" Compressed="yes" />
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of HubbyPDF is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="HubbyPDF.ico" SourceFile="$(var.IconSource)" />
    <Property Id="ARPPRODUCTICON" Value="HubbyPDF.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <UIRef Id="WixUI_Common" />
    <UI>
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="Minimal" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg">Installed</Publish>
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return">1</Publish>
      <InstallUISequence>
        <Show Dialog="WelcomeDlg" Before="ProgressDlg">NOT Installed</Show>
      </InstallUISequence>
    </UI>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="HubbyPDF">
          <Directory Id="LICENSEFOLDER" Name="licenses" />
          <Component Id="HubbyApp" Guid="*" Win64="yes">
            <File Id="HubbyExe" Source="$(var.AppSource)\HubbyPDF.exe" KeyPath="yes">
              <Shortcut Id="HubbyStartMenu" Directory="ProgramMenuFolder" Name="HubbyPDF"
                        Advertise="yes" WorkingDirectory="INSTALLFOLDER" Icon="HubbyPDF.ico" />
            </File>
            <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="HubbyPDF"
                           Type="string" Value="$(var.Capabilities)" />
            <RegistryKey Root="HKLM" Key="$(var.Capabilities)">
              <RegistryValue Name="ApplicationName" Type="string" Value="HubbyPDF" />
              <RegistryValue Name="ApplicationDescription" Type="string"
                             Value="Open, annotate, and sign PDF documents with HubbyPDF." />
              <RegistryValue Name="ApplicationIcon" Type="string" Value="&quot;[#HubbyExe]&quot;,0" />
              <RegistryKey Key="FileAssociations">
                <RegistryValue Name=".pdf" Type="string" Value="$(var.PdfProgId)" />
              </RegistryKey>
            </RegistryKey>
            <RegistryKey Root="HKLM" Key="Software\Classes\$(var.PdfProgId)">
              <RegistryValue Type="string" Value="PDF Document" />
              <RegistryKey Key="DefaultIcon">
                <RegistryValue Type="string" Value="&quot;[#HubbyExe]&quot;,0" />
              </RegistryKey>
              <RegistryKey Key="shell\open\command">
                <RegistryValue Type="string" Value="&quot;[#HubbyExe]&quot; &quot;%1&quot;" />
              </RegistryKey>
            </RegistryKey>
            <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids"
                           Name="$(var.PdfProgId)" Type="string" Value="" />
            <RegistryKey Root="HKLM" Key="Software\Classes\Applications\HubbyPDF.exe">
              <RegistryValue Name="FriendlyAppName" Type="string" Value="HubbyPDF" />
              <RegistryKey Key="SupportedTypes">
                <RegistryValue Name=".pdf" Type="string" Value="" />
              </RegistryKey>
              <RegistryKey Key="shell\open\command">
                <RegistryValue Type="string" Value="&quot;[#HubbyExe]&quot; &quot;%1&quot;" />
              </RegistryKey>
            </RegistryKey>
          </Component>
          <Component Id="Pdfium" Guid="*" Win64="yes">
            <File Id="PdfiumDll" Source="$(var.AppSource)\pdfium.dll" KeyPath="yes" />
          </Component>
          <Component Id="PdfiumLicense" Guid="*" Win64="yes">
            <File Id="PdfiumLicenseFile" Source="$(var.AppSource)\PDFium-LICENSE.txt" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>
    <Feature Id="HubbyPDF" Title="HubbyPDF" Level="1">
      <ComponentRef Id="HubbyApp" />
      <ComponentRef Id="Pdfium" />
      <ComponentRef Id="PdfiumLicense" />
      <ComponentGroupRef Id="PdfiumLicenses" />
    </Feature>
  </Product>
</Wix>
